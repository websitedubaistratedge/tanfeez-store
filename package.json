{
  "name": "tanfeez-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/asset-manifest.mjs",
    "dev": "next dev -p 3300",
    "prebuild": "node scripts/asset-manifest.mjs",
    "build": "next build",
    "start": "next start -p 3300",
    "preview": "node scripts/asset-manifest.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/asset-manifest.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "seed": "node scripts/seed.mjs && node scripts/apply-studio.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.51.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.155.0"
  }
